<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NitroStudio2.Views.InputBoxWindow"
        Width="380" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="12" Spacing="10">
        <TextBlock Name="Prompt" TextWrapping="Wrap" />
        <TextBox Name="Input" KeyDown="OnInputKeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="OkButton" Content="OK" Width="80" IsDefault="True" Click="OnOk" />
            <Button Name="CancelButton" Content="Cancel" Width="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
